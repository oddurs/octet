#!/usr/bin/env sh
set -eu

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

if ! printf '%s\n' "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_-]+\))?!?: .+'; then
    echo "error: commit message must follow Conventional Commits format:" >&2
    echo "  <type>[optional scope]: <description>" >&2
    echo "  Examples: 'feat: add Mach-O universal header annotations', 'fix(reverse): handle odd nybble errors'" >&2
    exit 1
fi
